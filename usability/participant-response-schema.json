{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erasemap.example/schemas/usability-response-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","participant_id","participant_nonce","language","consent","started_at","ended_at","card_order","responses"],
  "properties": {
    "schema_version": {"const":"erasemap-usability-response-v1"},
    "participant_id": {"type":"string","pattern":"^[A-Za-z0-9_-]{8,64}$"},
    "participant_nonce": {"type":"string","pattern":"^[A-Za-z0-9_-]{16,128}$"},
    "language": {"enum":["en","ru"]},
    "consent": {"const":true},
    "started_at": {"type":"string","format":"date-time"},
    "ended_at": {"type":"string","format":"date-time"},
    "card_order": {"type":"array","minItems":12,"maxItems":12,"uniqueItems":true,"items":{"type":"string","pattern":"^c[0-9]{2}$"}},
    "responses": {"type":"array","minItems":12,"maxItems":12,"items":{"type":"object","additionalProperties":false,"required":["card_id","explanation_choice","verdict","path_choice","action_choice","completion_ms"],"properties":{"card_id":{"type":"string","pattern":"^c[0-9]{2}$"},"explanation_choice":{"enum":["safe","residual","unknown"]},"verdict":{"enum":["COMPLETE","INCOMPLETE","UNVERIFIED"]},"path_choice":{"enum":["none","primary-to-derivative","backup-to-restore-to-primary","unknown"]},"action_choice":{"enum":["close-request","delete-derivative","block-recovery-and-replay","collect-missing-evidence"]},"completion_ms":{"type":"integer","minimum":1,"maximum":600000}}}}
  }
}
