{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "shortest_path", "verdict"],
    "properties": {
      "id": {"type": "string", "minLength": 1},
      "shortest_path": {"type": ["array", "null"], "items": {"type": "string"}},
      "verdict": {"enum": ["COMPLETE", "INCOMPLETE", "UNVERIFIED"]}
    }
  }
}
