  "strategies": [
    {
      "strategy_id": "active-minimax",
      "rule": "lexicographically minimize largest bucket, squared bucket sum, declared cost, and experiment ID"
    },
    {
      "strategy_id": "frozen-random-feasible",
      "rule": "choose uniformly from unused separating experiments using seed 25082026"
    },
    {
      "strategy_id": "greedy-separated-pairs",
      "rule": "maximize separated unordered graph pairs, then minimize declared cost and experiment ID"
    },
    {
      "strategy_id": "passive-declared-lineage",
      "rule": "execute no experiment and report the complete initial version space"
    },
    {
      "strategy_id": "flat-erasure-tomography",
      "rule": "collapse every temporal checkpoint trace to one recurrence bit and apply the same fail-closed filtering"
    },
    {
      "strategy_id": "nonadaptive-exhaustive",
      "rule": "execute every frozen experiment in experiment-ID order"
    }
  ],
  "random_seed": 25082026,
