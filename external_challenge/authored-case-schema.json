{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["case", "expected_path", "truth_verdict"],
    "properties": {
      "case": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence", "family", "graph", "id", "now_epoch", "subject_id"],
        "properties": {
          "evidence": {"type": "array", "items": {"type": "object"}},
          "family": {"type": "string", "minLength": 1},
          "graph": {
            "type": "object",
            "required": ["edges", "nodes"],
            "properties": {
              "edges": {"type": "array"},
              "nodes": {"type": "array", "minItems": 1}
            }
          },
          "id": {"type": "string", "minLength": 1},
          "now_epoch": {"type": "integer", "minimum": 0},
          "subject_id": {"type": "string", "minLength": 1}
        }
      },
      "expected_path": {"type": ["array", "null"], "items": {"type": "string"}},
      "truth_verdict": {"enum": ["COMPLETE", "INCOMPLETE", "UNVERIFIED"]}
    }
  }
}
